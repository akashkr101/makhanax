{
  "name": "makhana-x",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:test": "ng build --configuration test",
    "build:production": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/order-validation.test.mjs && node scripts/order-lifecycle.test.mjs && node scripts/demo-mode.test.mjs",
    "test:build": "node scripts/build-artifact.test.mjs",
    "test:coverage": "c8 --reporter=lcov --reporter=text --reports-dir=coverage npm test",
    "test:security": "npm run build --prefix functions && npx --yes firebase-tools@15.33.0 emulators:exec --only auth,firestore,functions --project demo-makhanax \"node --import tsx scripts/backend-security.test.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.14.1",
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@emailjs/browser": "^4.4.1",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "c8": "^12.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
}
